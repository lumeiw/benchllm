    <edge id="e4454" source="C.physics.elektricheskiy-zaryad" target="C.physics.tochechnyy-zaryad"><data key="e_type">prerequisites_for</data><data key="e_why">точечный заряд — заряженное тело пренебрежимо малых размеров</data></edge>
    <edge id="e4455" source="C.physics.tochechnyy-zaryad" target="C.physics.fizicheskaya-model"><data key="e_type">is_a</data><data key="e_why">точечный заряд — идеализация, как материальная точка</data></edge>
    <edge id="e4456" source="C.physics.tochechnyy-zaryad" target="C.physics.zakon-kulona"><data key="e_order_issue">True</data><data key="e_type">prerequisites_for</data><data key="e_why">закон Кулона сформулирован для точечных зарядов</data></edge>
