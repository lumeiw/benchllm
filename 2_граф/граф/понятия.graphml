    <edge id="e362" source="C.history.likvidatsiya-soslovnyh-privilegiy" target="C.history.pervye-revolyutsionnye-preobrazovaniya-bolshevikov"><data key="e_type">part_of</data><data key="e_why">декрет 1917 г. об уничтожении сословий</data></edge>
    <edge id="e363" source="C.history.otdelenie-tserkvi-ot-gosudarstva" target="C.history.sekulyarizatsiya-zhizni-obschestva"><data key="e_type">prerequisites_for</data><data key="e_why">после отделения Церкви жизнь общества стала светской</data></edge>
    <edge id="e364" source="C.history.zhenskoe-dvizhenie" target="C.history.emansipatsiya-zhenschin"><data key="e_type">prerequisites_for</data><data key="e_why">равноправия женщин добивалось женское движение</data></edge>
    <edge id="e365" source="C.history.emansipatsiya-zhenschin" target="C.history.sotsialnaya-politika-bolshevikov"><data key="e_type">part_of</data><data key="e_why">законы о равноправии полов</data></edge>
    <edge id="e366" source="C.history.subbotniki" target="C.history.povsednevnaya-zhizn-na-rusi"><data key="e_type">part_of</data><data key="e_why">быт городов в годы Гражданской войны</data></edge>
    <edge id="e367" source="C.history.grazhdanskaya-voyna-v-rossii" target="C.history.detskaya-besprizornost"><data key="e_type">prerequisites_for</data><data key="e_why">война оставила миллионы детей без родителей</data></edge>
    <edge id="e368" source="C.history.grazhdanskaya-voyna-v-rossii" target="C.history.ekonomicheskaya-razruha"><data key="e_type">prerequisites_for</data><data key="e_why">разруха — итог мировой и Гражданской войн</data></edge>
    <edge id="e369" source="C.history.ekonomicheskaya-razruha" target="C.history.golod-1921-1922-godov"><data key="e_type">prerequisites_for</data><data key="e_why">голод разразился в разорённой стране</data></edge>
    <edge id="e370" source="C.history.golod-1921-1922-godov" target="C.history.rekvizitsiya-tserkovnogo-imuschestva"><data key="e_type">prerequisites_for</data><data key="e_why">изъятие ценностей шло под предлогом помощи голодающим</data></edge>
    <edge id="e371" source="C.history.rekvizitsiya-tserkovnogo-imuschestva" target="C.history.presledovanie-svyaschennosluzhiteley"><data key="e_type">prerequisites_for</data><data key="e_why">сопротивление изъятию вызвало репрессии против духовенства</data></edge>
    <edge id="e372" source="C.history.prodrazverstka" target="C.history.krestyanskie-vosstaniya"><data key="e_type">prerequisites_for</data><data key="e_why">крестьяне восставали против продразвёрстки</data></edge>
    <edge id="e373" source="C.history.prodrazverstka" target="C.history.kronshtadtskoe-vosstanie"><data key="e_type">prerequisites_for</data><data key="e_why">матросы требовали отменить продразвёрстку</data></edge>
    <edge id="e374" source="C.history.voennyy-kommunizm" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">prerequisites_for</data><data key="e_why">нэп сменил военный коммунизм</data></edge>
    <edge id="e375" source="C.history.krestyanskie-vosstaniya" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">prerequisites_for</data><data key="e_why">восстания вынудили большевиков отказаться от продразвёрстки</data></edge>
    <edge id="e376" source="C.history.kronshtadtskoe-vosstanie" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">prerequisites_for</data><data key="e_why">восстание ускорило переход к нэпу</data></edge>
    <edge id="e377" source="C.history.ekonomicheskaya-razruha" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">prerequisites_for</data><data key="e_why">нэп должен был восстановить разрушенное хозяйство</data></edge>
    <edge id="e378" source="C.history.prodrazverstka" target="C.history.prodnalog"><data key="e_type">prerequisites_for</data><data key="e_why">продналог заменил продразвёрстку</data></edge>
    <edge id="e379" source="C.history.prodnalog" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">первая мера нэпа</data></edge>
    <edge id="e380" source="C.history.tovarno-denezhnye-otnosheniya" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">нэп вернул рынок и торговлю</data></edge>
    <edge id="e381" source="C.history.kooperatsiya" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">нэп поощрял кооперацию</data></edge>
    <edge id="e382" source="C.history.finansovaya-reforma-1922-1924-godov" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">введение твёрдого червонца</data></edge>
    <edge id="e383" source="C.history.gosplan" target="C.history.pyatiletnie-plany"><data key="e_type">prerequisites_for</data><data key="e_why">Госплан разрабатывал пятилетние планы</data></edge>
    <edge id="e384" source="C.history.zvanie-geroya-truda" target="C.history.sotsialisticheskoe-sorevnovanie"><data key="e_type">prerequisites_for</data><data key="e_why">почётное звание поощряло лучших работников</data></edge>
