    <edge id="e2994" source="C.history.ispanskie-i-portugalskie-kolonii-v-yuzhnoy-amerike" target="C.history.strany-latinskoy-ameriki-v-xix-nachale-xx-veka"><data key="e_type">prerequisites_for</data><data key="e_why">латиноамериканские государства возникли на месте колоний</data></edge>
    <edge id="e2995" source="C.history.kolonialnoe-obschestvo" target="C.history.ispanskie-i-portugalskie-kolonii-v-yuzhnoy-amerike"><data key="e_type">part_of</data><data key="e_why">общество колоний</data></edge>
