    <edge id="e3014" source="C.history.kitay" target="C.history.strany-vostoka-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">одна из стран Востока</data></edge>
    <edge id="e3015" source="C.history.indiya" target="C.history.strany-vostoka-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">одна из стран Востока</data></edge>
    <edge id="e3016" source="C.history.iran" target="C.history.strany-vostoka-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">одна из стран Востока</data></edge>
    <edge id="e3017" source="C.history.osmanskaya-imperiya" target="C.history.strany-vostoka-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">одна из стран Востока</data></edge>
