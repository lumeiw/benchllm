    <edge id="e3006" source="C.history.yaponiya" target="C.history.strany-vostoka-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">одна из стран Востока</data></edge>
    <edge id="e3007" source="C.history.zakrytie-yaponii-dlya-inozemtsev" target="C.history.otkrytie-yaponii"><data key="e_type">prerequisites_for</data><data key="e_why">«открытие» положило конец самоизоляции Японии</data></edge>
