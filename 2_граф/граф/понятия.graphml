    <edge id="e4460" source="C.physics.zakon-kulona" target="C.physics.pole-tochechnogo-zaryada"><data key="e_type">prerequisites_for</data><data key="e_why">напряжённость поля точечного заряда следует из закона Кулона</data></edge>
