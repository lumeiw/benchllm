    <edge id="e2978" source="C.history.grazhdanskaya-voyna-v-ssha" target="C.history.vosstanovlenie-yuga"><data key="e_type">prerequisites_for</data><data key="e_why">реконструкция Юга после войны</data></edge>
    <edge id="e2979" source="C.history.grazhdanskaya-voyna-v-ssha" target="C.history.promyshlennyy-rost-ssha"><data key="e_type">prerequisites_for</data><data key="e_why">победа Севера открыла путь быстрому промышленному росту</data></edge>
