    <edge id="e3009" source="C.history.restavratsiya-meydzi" target="C.history.modernizatsiya"><data key="e_type">is_a</data><data key="e_why">реформы Мэйдзи — пример модернизации</data></edge>
    <edge id="e3010" source="C.history.restavratsiya-meydzi" target="C.history.konstitutsiya-yaponii"><data key="e_type">prerequisites_for</data><data key="e_why">конституция — итог реформ Мэйдзи</data></edge>
