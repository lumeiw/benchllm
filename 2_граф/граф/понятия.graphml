    <edge id="e3826" source="C.physics.izmerenie-rasstoyaniy" target="C.physics.opredelenie-razmerov-malyh-tel"><data key="e_type">prerequisites_for</data><data key="e_why">метод рядов основан на измерении длины ряда</data></edge>
