    <edge id="e2896" source="C.history.parlamentskaya-monarhiya" target="C.history.konstitutsionnaya-monarhiya"><data key="e_type">is_a</data><data key="e_why">парламентская монархия — вид конституционной монархии</data></edge>
    <edge id="e2897" source="C.history.konstitutsionnaya-monarhiya" target="C.history.razvitie-evropeyskih-stran-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">утверждение конституционных монархий — черта развития Европы XIX в.</data></edge>
    <edge id="e2898" source="C.history.promyshlennyy-perevorot" target="C.history.industrialnoe-obschestvo"><data key="e_type">prerequisites_for</data><data key="e_why">промышленный переворот создал индустриальное общество</data></edge>
    <edge id="e2899" source="C.history.industrialnoe-obschestvo" target="C.history.sotsializm"><data key="e_type">prerequisites_for</data><data key="e_why">социалисты критиковали несправедливость индустриального общества</data></edge>
    <edge id="e2900" source="C.history.sotsialisty-utopisty" target="C.history.sotsializm"><data key="e_type">part_of</data><data key="e_why">утописты — ранние социалисты</data></edge>
    <edge id="e2901" source="C.history.fabrichnye-rabochie" target="C.history.rabochee-dvizhenie"><data key="e_type">prerequisites_for</data><data key="e_why">рабочее движение — борьба рабочих за свои права</data></edge>
    <edge id="e2902" source="C.history.luddizm" target="C.history.rabochee-dvizhenie"><data key="e_type">part_of</data><data key="e_why">луддизм — ранняя форма рабочего движения</data></edge>
    <edge id="e2903" source="C.history.politika-napoleona-v-zavoevannyh-stranah" target="C.history.natsionalnye-dvizheniya-v-evrope"><data key="e_type">prerequisites_for</data><data key="e_why">сопротивление Наполеону пробудило национальное самосознание народов</data></edge>
    <edge id="e2904" source="C.history.natsionalnye-dvizheniya-v-evrope" target="C.history.razvitie-evropeyskih-stran-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">национальные движения — черта развития Европы XIX в.</data></edge>
    <edge id="e2905" source="C.history.frantsuzskaya-revolyutsiya" target="C.history.konservatizm"><data key="e_type">prerequisites_for</data><data key="e_why">консерватизм возник как реакция на революцию</data></edge>
    <edge id="e2906" source="C.history.prosveschenie" target="C.history.liberalizm"><data key="e_type">prerequisites_for</data><data key="e_why">либерализм вырос из идей Просвещения</data></edge>
    <edge id="e2907" source="C.history.liberalizm" target="C.history.radikalizm"><data key="e_type">prerequisites_for</data><data key="e_why">радикалы требовали более решительных перемен, чем либералы</data></edge>
    <edge id="e2908" source="C.history.konservatizm" target="C.history.politicheskie-partii"><data key="e_type">prerequisites_for</data><data key="e_why">консервативные партии выражали идеи консерватизма</data></edge>
    <edge id="e2909" source="C.history.liberalizm" target="C.history.politicheskie-partii"><data key="e_type">prerequisites_for</data><data key="e_why">либеральные партии выражали идеи либерализма</data></edge>
    <edge id="e2910" source="C.history.tori" target="C.history.politicheskie-partii"><data key="e_type">is_a</data><data key="e_why">тори — одна из первых политических партий</data></edge>
    <edge id="e2911" source="C.history.vigi" target="C.history.politicheskie-partii"><data key="e_type">is_a</data><data key="e_why">виги — одна из первых политических партий</data></edge>
    <edge id="e2912" source="C.history.evropa-v-nachale-xix-veka" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">prerequisites_for</data><data key="e_why">после 1815 г. Европа жила по решениям Венского конгресса</data></edge>
    <edge id="e2913" source="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody" target="C.history.razvitie-evropeyskih-stran-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">1815–1840-е гг. — этап развития европейских стран</data></edge>
    <edge id="e2914" source="C.history.krushenie-imperii-napoleona-i" target="C.history.restavratsiya-vo-frantsii"><data key="e_type">prerequisites_for</data><data key="e_why">после падения Наполеона во Франции восстановлены Бурбоны</data></edge>
    <edge id="e2915" source="C.history.restavratsiya-vo-frantsii" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">Реставрация — период истории Франции 1815–1830 гг.</data></edge>
    <edge id="e2916" source="C.history.restavratsiya-vo-frantsii" target="C.history.evropeyskie-revolyutsii-1830-goda"><data key="e_type">prerequisites_for</data><data key="e_why">Июльская революция 1830 г. свергла Бурбонов</data></edge>
    <edge id="e2917" source="C.history.evropeyskie-revolyutsii-1830-goda" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">революции 1830 г. — события 1815–1840-х гг.</data></edge>
    <edge id="e2918" source="C.history.evropeyskie-revolyutsii-1830-goda" target="C.history.iyulskaya-monarhiya"><data key="e_type">prerequisites_for</data><data key="e_why">Июльская монархия установлена революцией 1830 г.</data></edge>
    <edge id="e2919" source="C.history.iyulskaya-monarhiya" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">Июльская монархия — период истории Франции 1830–1848 гг.</data></edge>
    <edge id="e2920" source="C.history.iyulskaya-monarhiya" target="C.history.evropeyskie-revolyutsii-1848-1849-godov"><data key="e_type">prerequisites_for</data><data key="e_why">Февральская революция 1848 г. свергла Июльскую монархию</data></edge>
    <edge id="e2921" source="C.history.natsionalnye-dvizheniya-v-evrope" target="C.history.evropeyskie-revolyutsii-1848-1849-godov"><data key="e_type">prerequisites_for</data><data key="e_why">национальные требования — одна из причин «весны народов»</data></edge>
    <edge id="e2922" source="C.history.evropeyskie-revolyutsii-1848-1849-godov" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">революции 1848–1849 гг. завершили период</data></edge>
    <edge id="e2923" source="C.history.evropeyskie-revolyutsii-1848-1849-godov" target="C.history.vtoraya-respublika-vo-frantsii"><data key="e_type">prerequisites_for</data><data key="e_why">Вторая республика провозглашена революцией 1848 г.</data></edge>
    <edge id="e2924" source="C.history.vtoraya-respublika-vo-frantsii" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">Вторая республика — Франция 1848–1852 гг.</data></edge>
    <edge id="e2925" source="C.history.natsionalnye-dvizheniya-v-evrope" target="C.history.osvobozhdenie-gretsii"><data key="e_type">prerequisites_for</data><data key="e_why">греки восстали за национальную независимость</data></edge>
    <edge id="e2926" source="C.history.osmanskaya-imperiya" target="C.history.osvobozhdenie-gretsii"><data key="e_type">prerequisites_for</data><data key="e_why">Греция освободилась от османского господства</data></edge>
    <edge id="e2927" source="C.history.osvobozhdenie-gretsii" target="C.history.politicheskoe-razvitie-evropy-v-1815-1840-e-gody"><data key="e_type">part_of</data><data key="e_why">независимость Греции — итог освободительного движения 1820-х гг.</data></edge>
    <edge id="e2928" source="C.history.parlament" target="C.history.parlamentskaya-reforma-v-velikobritanii"><data key="e_type">prerequisites_for</data><data key="e_why">реформа изменила порядок выборов в парламент</data></edge>
    <edge id="e2929" source="C.history.parlamentskaya-reforma-v-velikobritanii" target="C.history.reformy-v-velikobritanii"><data key="e_type">part_of</data><data key="e_why">реформа 1832 г. — первая из парламентских реформ</data></edge>
    <edge id="e2930" source="C.history.parlamentskaya-reforma-v-velikobritanii" target="C.history.chartizm"><data key="e_type">prerequisites_for</data><data key="e_why">рабочие, не получившие права голоса, выдвинули Хартию</data></edge>
    <edge id="e2931" source="C.history.chartizm" target="C.history.rabochee-dvizhenie"><data key="e_type">part_of</data><data key="e_why">чартизм — массовое рабочее движение в Англии</data></edge>
    <edge id="e2932" source="C.history.marksizm" target="C.history.sotsializm"><data key="e_type">is_a</data><data key="e_why">марксизм — течение социализма</data></edge>
    <edge id="e2933" source="C.history.sotsialisty-utopisty" target="C.history.marksizm"><data key="e_type">prerequisites_for</data><data key="e_why">Маркс опирался на критику капитализма утопистами</data></edge>
    <edge id="e2934" source="C.history.velikobritaniya" target="C.history.viktorianskaya-epoha"><data key="e_type">prerequisites_for</data><data key="e_why">викторианская эпоха — период истории Великобритании</data></edge>
    <edge id="e2935" source="C.history.promyshlennyy-perevorot" target="C.history.masterskaya-mira"><data key="e_type">prerequisites_for</data><data key="e_why">после промышленного переворота Англия стала «мастерской мира»</data></edge>
    <edge id="e2936" source="C.history.masterskaya-mira" target="C.history.viktorianskaya-epoha"><data key="e_type">part_of</data><data key="e_why">промышленное первенство — черта викторианской Англии</data></edge>
    <edge id="e2937" source="C.history.reformy-v-velikobritanii" target="C.history.viktorianskaya-epoha"><data key="e_type">part_of</data><data key="e_why">политические и социальные реформы проведены в викторианскую эпоху</data></edge>
    <edge id="e2938" source="C.history.britanskaya-kolonialnaya-imperiya" target="C.history.kolonialnaya-imperiya"><data key="e_type">is_a</data><data key="e_why">Британская империя — крупнейшая колониальная империя</data></edge>
    <edge id="e2939" source="C.history.velikobritaniya" target="C.history.britanskaya-kolonialnaya-imperiya"><data key="e_type">prerequisites_for</data><data key="e_why">империю создала Великобритания</data></edge>
    <edge id="e2940" source="C.history.britanskoe-vladychestvo-v-indii" target="C.history.britanskaya-kolonialnaya-imperiya"><data key="e_type">part_of</data><data key="e_why">Индия — главное владение Британской империи</data></edge>
    <edge id="e2941" source="C.history.dominion" target="C.history.britanskaya-kolonialnaya-imperiya"><data key="e_type">part_of</data><data key="e_why">доминионы — самоуправляемые части Британской империи</data></edge>
    <edge id="e2942" source="C.history.vtoraya-respublika-vo-frantsii" target="C.history.imperiya-napoleona-iii"><data key="e_type">prerequisites_for</data><data key="e_why">президент республики в 1852 г. стал императором</data></edge>
    <edge id="e2943" source="C.history.napoleon-iii" target="C.history.imperiya-napoleona-iii"><data key="e_type">participant_of</data><data key="e_why">Наполеон III — император Второй империи</data></edge>
    <edge id="e2944" source="C.history.napoleon-iii" target="C.history.vtoraya-respublika-vo-frantsii"><data key="e_type">participant_of</data><data key="e_why">Луи Наполеон был президентом Второй республики</data></edge>
    <edge id="e2945" source="C.history.imperiya-napoleona-iii" target="C.history.franko-germanskaya-voyna"><data key="e_type">prerequisites_for</data><data key="e_why">война Второй империи с Пруссией</data></edge>
    <edge id="e2946" source="C.history.franko-germanskaya-voyna" target="C.history.obedinenie-germanii"><data key="e_type">part_of</data><data key="e_why">победа над Францией завершила объединение Германии</data></edge>
    <edge id="e2947" source="C.history.franko-germanskaya-voyna" target="C.history.parizhskaya-kommuna"><data key="e_type">prerequisites_for</data><data key="e_why">коммуна возникла после поражения Франции в войне</data></edge>
    <edge id="e2948" source="C.history.usilenie-vlasti-gabsburgov-v-italii" target="C.history.obedinenie-italii"><data key="e_type">prerequisites_for</data><data key="e_why">итальянцы боролись за освобождение от власти Австрии и единство</data></edge>
    <edge id="e2949" source="C.history.natsionalnye-dvizheniya-v-evrope" target="C.history.obedinenie-italii"><data key="e_type">prerequisites_for</data><data key="e_why">объединение Италии — итог национального движения итальянцев</data></edge>
    <edge id="e2950" source="C.history.obedinenie-italii" target="C.history.razvitie-evropeyskih-stran-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">образование единого государства в Италии</data></edge>
    <edge id="e2951" source="C.history.k-kavur" target="C.history.obedinenie-italii"><data key="e_type">participant_of</data><data key="e_why">Кавур — руководитель объединения Италии вокруг Пьемонта</data></edge>
    <edge id="e2952" source="C.history.dzh-garibaldi" target="C.history.obedinenie-italii"><data key="e_type">participant_of</data><data key="e_why">Гарибальди — герой борьбы за объединение Италии</data></edge>
    <edge id="e2953" source="C.history.viktor-emmanuil-ii" target="C.history.obedinenie-italii"><data key="e_type">participant_of</data><data key="e_why">Виктор Эммануил II — первый король единой Италии</data></edge>
    <edge id="e2954" source="C.history.vozvyshenie-prussii" target="C.history.obedinenie-germanii"><data key="e_type">prerequisites_for</data><data key="e_why">объединение Германии произошло вокруг Пруссии</data></edge>
    <edge id="e2955" source="C.history.natsionalnye-dvizheniya-v-evrope" target="C.history.obedinenie-germanii"><data key="e_type">prerequisites_for</data><data key="e_why">движение за объединение германских государств</data></edge>
    <edge id="e2956" source="C.history.o-bismark" target="C.history.obedinenie-germanii"><data key="e_type">participant_of</data><data key="e_why">Бисмарк объединил Германию «железом и кровью»</data></edge>
    <edge id="e2957" source="C.history.severogermanskiy-soyuz" target="C.history.obedinenie-germanii"><data key="e_type">part_of</data><data key="e_why">Северогерманский союз — этап объединения Германии</data></edge>
    <edge id="e2958" source="C.history.obedinenie-germanii" target="C.history.germanskaya-imperiya"><data key="e_type">prerequisites_for</data><data key="e_why">итог объединения — провозглашение Германской империи</data></edge>
    <edge id="e2959" source="C.history.germanskaya-imperiya" target="C.history.razvitie-evropeyskih-stran-v-xix-nachale-xx-veka"><data key="e_type">part_of</data><data key="e_why">создание Германской империи изменило карту Европы</data></edge>
    <edge id="e2960" source="C.history.o-bismark" target="C.history.germanskaya-imperiya"><data key="e_type">participant_of</data><data key="e_why">Бисмарк — первый канцлер Германской империи</data></edge>
    <edge id="e2961" source="C.history.germanskaya-imperiya" target="C.history.sotsialnaya-politika-v-germanii"><data key="e_type">prerequisites_for</data><data key="e_why">социальная политика Германской империи</data></edge>
    <edge id="e2962" source="C.history.rabochee-dvizhenie" target="C.history.sotsialnaya-politika-v-germanii"><data key="e_type">prerequisites_for</data><data key="e_why">социальные законы — ответ на рост рабочего движения</data></edge>
    <edge id="e2963" source="C.history.derzhava-avstriyskih-gabsburgov" target="C.history.avstro-vengriya"><data key="e_type">prerequisites_for</data><data key="e_why">в 1867 г. империя Габсбургов стала Австро-Венгрией</data></edge>
    <edge id="e2964" source="C.history.avstro-vengriya" target="C.history.strany-tsentralnoy-yuzhnoy-i-yugo-vostochnoy-evropy"><data key="e_type">part_of</data><data key="e_why">Австро-Венгрия — крупнейшее государство Центральной Европы</data></edge>
    <edge id="e2965" source="C.history.yuzhnye-slavyane" target="C.history.osvoboditelnaya-borba-yuzhnyh-slavyan"><data key="e_type">prerequisites_for</data><data key="e_why">борьба южнославянских народов за освобождение</data></edge>
    <edge id="e2966" source="C.history.polozhenie-pokorennyh-narodov-v-osmanskoy-imperii" target="C.history.osvoboditelnaya-borba-yuzhnyh-slavyan"><data key="e_type">prerequisites_for</data><data key="e_why">славяне восставали против османского гнёта</data></edge>
    <edge id="e2967" source="C.history.osvoboditelnaya-borba-yuzhnyh-slavyan" target="C.history.natsionalnye-dvizheniya-v-evrope"><data key="e_type">part_of</data><data key="e_why">борьба южных славян — часть национальных движений</data></edge>
    <edge id="e2968" source="C.history.osvoboditelnaya-borba-yuzhnyh-slavyan" target="C.history.russko-turetskaya-voyna-1877-1878-godov"><data key="e_type">prerequisites_for</data><data key="e_why">Россия вступила в войну в защиту балканских славян</data></edge>
    <edge id="e2969" source="C.history.russko-turetskaya-voyna-1877-1878-godov" target="C.history.russko-turetskie-voyny"><data key="e_type">part_of</data><data key="e_why">одна из русско-турецких войн</data></edge>
    <edge id="e2970" source="C.history.sever-ssha" target="C.history.ssha"><data key="e_type">part_of</data><data key="e_why">Север — промышленная часть США</data></edge>
    <edge id="e2971" source="C.history.yug-ssha" target="C.history.ssha"><data key="e_type">part_of</data><data key="e_why">Юг — рабовладельческая часть США</data></edge>
    <edge id="e2972" source="C.history.rabstvo" target="C.history.yug-ssha"><data key="e_type">prerequisites_for</data><data key="e_why">хозяйство Юга держалось на рабском труде на плантациях</data></edge>
    <edge id="e2973" source="C.history.rabstvo" target="C.history.abolitsionizm"><data key="e_type">prerequisites_for</data><data key="e_why">аболиционисты добивались отмены рабства</data></edge>
    <edge id="e2974" source="C.history.abolitsionizm" target="C.history.grazhdanskaya-voyna-v-ssha"><data key="e_type">prerequisites_for</data><data key="e_why">спор о рабстве привёл к войне</data></edge>
    <edge id="e2975" source="C.history.sever-ssha" target="C.history.grazhdanskaya-voyna-v-ssha"><data key="e_type">prerequisites_for</data><data key="e_why">война Севера против Юга</data></edge>
    <edge id="e2976" source="C.history.yug-ssha" target="C.history.grazhdanskaya-voyna-v-ssha"><data key="e_type">prerequisites_for</data><data key="e_why">южные штаты отделились и начали войну</data></edge>
