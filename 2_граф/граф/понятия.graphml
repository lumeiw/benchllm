    <edge id="e3039" source="C.history.britanskaya-kolonialnaya-imperiya" target="C.history.anglo-burskaya-voyna"><data key="e_type">prerequisites_for</data><data key="e_why">Британия стремилась присоединить бурские республики</data></edge>
