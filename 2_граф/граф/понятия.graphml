    <edge id="e4458" source="C.physics.napryazhennost-elektricheskogo-polya" target="C.physics.odnorodnoe-elektricheskoe-pole"><data key="e_type">prerequisites_for</data><data key="e_why">в однородном поле напряжённость одинакова во всех точках</data></edge>
