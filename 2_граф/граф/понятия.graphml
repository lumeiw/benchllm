    <edge id="e388" source="C.history.bolsheviki" target="C.history.vkp-b"><data key="e_type">prerequisites_for</data><data key="e_why">ВКП(б) — партия большевиков</data></edge>
    <edge id="e389" source="C.history.bolsheviki" target="C.history.likvidatsiya-nebolshevistskih-partiy"><data key="e_type">prerequisites_for</data><data key="e_why">большевики уничтожили другие партии</data></edge>
    <edge id="e390" source="C.history.likvidatsiya-nebolshevistskih-partiy" target="C.history.odnopartiynaya-sistema"><data key="e_type">prerequisites_for</data><data key="e_why">в стране осталась одна партия</data></edge>
    <edge id="e391" source="C.history.vkp-b" target="C.history.odnopartiynaya-sistema"><data key="e_type">part_of</data><data key="e_why">единственная правящая партия</data></edge>
