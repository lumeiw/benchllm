    <edge id="e398" source="C.history.ohrana-materinstva-i-detstva" target="C.history.sotsialnaya-politika-bolshevikov"><data key="e_type">part_of</data><data key="e_why">забота о матерях и детях</data></edge>
    <edge id="e399" source="C.history.bezrabotitsa" target="C.history.sotsialnaya-politika-bolshevikov"><data key="e_type">prerequisites_for</data><data key="e_why">власть принимала меры против безработицы</data></edge>
