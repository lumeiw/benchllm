    <edge id="e11391" source="C.history.vchk" target="C.history.organy-gosbezopasnosti"><data key="e_type">is_a</data><data key="e_why">первый советский орган госбезопасности</data></edge>
    <edge id="e11392" source="C.history.vysshiy-sovet-narodnogo-hozyaystva" target="C.history.sovetskaya-rossiya"><data key="e_type">part_of</data><data key="e_why">орган управления экономикой</data></edge>
