    <edge id="e15136" source="C.physics.atmosfernoe-davlenie" target="C.physics.temperatura-kipeniya"><data key="e_type">prerequisites_for</data><data key="e_why">температура кипения зависит от атмосферного давления</data></edge>
    <edge id="e15137" source="C.physics.paroobrazovanie" target="C.physics.udelnaya-teplota-paroobrazovaniya"><data key="e_type">prerequisites_for</data><data key="e_why">величина характеризует парообразование</data></edge>
    <edge id="e15138" source="C.physics.kolichestvo-teploty" target="C.physics.udelnaya-teplota-paroobrazovaniya"><data key="e_type">prerequisites_for</data><data key="e_why">L = Q/m</data></edge>
    <edge id="e15139" source="C.physics.massa" target="C.physics.udelnaya-teplota-paroobrazovaniya"><data key="e_type">prerequisites_for</data><data key="e_why">теплота парообразования отнесена к единице массы</data></edge>
