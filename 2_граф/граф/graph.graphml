    <edge id="e11461" source="C.history.tovarno-denezhnye-otnosheniya" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">нэп вернул рынок и торговлю</data></edge>
    <edge id="e11462" source="C.history.kooperatsiya" target="C.history.novaya-ekonomicheskaya-politika"><data key="e_type">part_of</data><data key="e_why">нэп поощрял кооперацию</data></edge>
