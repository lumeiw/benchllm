    <node id="OOO.physics.les.g7.6"><data key="n_code">6</data><data key="n_grade">7</data><data key="n_hours">1.0</data><data key="n_label">Урок 6. Урок-исследование "Проверка гипотезы: дальность полёта шарика, пущенного горизонтально, тем больше, чем больше высота пу</data><data key="n_level">OOO</data><data key="n_subject">physics</data><data key="n_type">lesson</data></node>
