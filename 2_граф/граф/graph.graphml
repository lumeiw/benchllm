    <edge id="e11347" source="C.history.pervaya-mirovaya-voyna" target="C.history.oborontsy"><data key="e_type">prerequisites_for</data><data key="e_why">оборонцы поддерживали войну до победы</data></edge>
    <edge id="e11348" source="C.history.pervaya-mirovaya-voyna" target="C.history.internatsionalisty"><data key="e_type">prerequisites_for</data><data key="e_why">интернационалисты выступали за мир без аннексий</data></edge>
