    <node id="SOO.physics.les.g10.11"><data key="n_code">11</data><data key="n_grade">10</data><data key="n_hours">1.0</data><data key="n_label">Урок 11. Закон всемирного тяготения. Сила тяжести. Первая космическая скорость</data><data key="n_level">SOO</data><data key="n_subject">physics</data><data key="n_type">lesson</data></node>
