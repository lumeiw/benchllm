    <edge id="e14903" source="C.physics.izmerenie-temperatury-zhidkostnym-termometrom-i-datchikom-temperatury" target="C.physics.izmerenie-fizicheskih-velichin"><data key="e_type">is_a</data><data key="e_why">частный случай измерения физической величины</data></edge>
    <edge id="e14904" source="C.physics.izmerenie-temperatury-zhidkostnym-termometrom-i-datchikom-temperatury" target="C.physics.temperatura"><data key="e_type">verifies</data><data key="e_why">в работе измеряется температура</data></edge>
