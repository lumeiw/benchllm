    <edge id="e11386" source="C.history.razgon-uchreditelnogo-sobraniya" target="C.history.pervye-revolyutsionnye-preobrazovaniya-bolshevikov"><data key="e_type">part_of</data><data key="e_why">слом старого государственного порядка</data></edge>
    <edge id="e11387" source="C.history.vtsik" target="C.history.sovetskaya-rossiya"><data key="e_type">part_of</data><data key="e_why">высший орган Советов между съездами</data></edge>
