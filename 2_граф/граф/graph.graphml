    <edge id="e14967" source="C.physics.trenie" target="C.physics.sila-treniya"><data key="e_type">prerequisites_for</data><data key="e_why">сила трения характеризует трение</data></edge>
    <edge id="e14968" source="C.physics.sila-treniya" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила трения — вид силы</data></edge>
