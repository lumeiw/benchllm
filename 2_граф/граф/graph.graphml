    <edge id="e14957" source="C.physics.zakon-guka" target="C.physics.dinamometr"><data key="e_type">prerequisites_for</data><data key="e_why">действие динамометра основано на законе Гука</data></edge>
    <edge id="e14958" source="C.physics.dinamometr" target="C.physics.fizicheskiy-pribor"><data key="e_type">is_a</data><data key="e_why">динамометр — измерительный прибор</data></edge>
    <edge id="e14959" source="C.physics.ves-tela" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">вес — сила, с которой тело действует на опору или подвес</data></edge>
    <edge id="e14960" source="C.physics.sila-tyazhesti" target="C.physics.ves-tela"><data key="e_type">prerequisites_for</data><data key="e_why">вес возникает из-за притяжения тела к Земле</data></edge>
    <edge id="e14961" source="C.physics.ves-tela" target="C.physics.nevesomost"><data key="e_type">prerequisites_for</data><data key="e_why">невесомость — состояние, при котором вес тела равен нулю</data></edge>
    <edge id="e14962" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.vzaimodeystvie-tel"><data key="e_type">is_a</data><data key="e_why">тяготение — взаимное притяжение тел</data></edge>
    <edge id="e14963" source="C.physics.vsemirnoe-tyagotenie" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">сила тяжести — проявление всемирного тяготения</data></edge>
    <edge id="e14964" source="C.physics.massa" target="C.physics.sila-tyazhesti"><data key="e_type">prerequisites_for</data><data key="e_why">F = mg: сила тяжести пропорциональна массе</data></edge>
    <edge id="e14965" source="C.physics.sila-tyazhesti" target="C.physics.sila"><data key="e_type">is_a</data><data key="e_why">сила тяжести — вид силы</data></edge>
