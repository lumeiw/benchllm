    <edge id="e14922" source="C.physics.ottalkivanie-chastits-veschestva" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">отталкивание — вид взаимодействия частиц</data></edge>
    <edge id="e14923" source="C.physics.prityazhenie-chastits-veschestva" target="C.physics.vzaimodeystvie-chastits-veschestva"><data key="e_type">is_a</data><data key="e_why">притяжение — вид взаимодействия частиц</data></edge>
    <edge id="e14924" source="C.physics.stroenie-veschestva" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">агрегатные состояния различаются строением вещества</data></edge>
    <edge id="e14925" source="C.physics.vzaimodeystvie-chastits-veschestva" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">prerequisites_for</data><data key="e_why">состояние определяется взаимодействием и расположением частиц</data></edge>
    <edge id="e14926" source="C.physics.gaz" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">газ — одно из агрегатных состояний</data></edge>
    <edge id="e14927" source="C.physics.zhidkost" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">жидкость — одно из агрегатных состояний</data></edge>
    <edge id="e14928" source="C.physics.tverdoe-telo" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">твёрдое тело — одно из агрегатных состояний</data></edge>
    <edge id="e14929" source="C.physics.agregatnye-sostoyaniya-vody" target="C.physics.agregatnye-sostoyaniya-veschestva"><data key="e_type">is_a</data><data key="e_why">частный случай агрегатных состояний вещества</data></edge>
    <edge id="e14930" source="C.physics.nablyudenie-teplovogo-rasshireniya-gazov" target="C.physics.teplovoe-rasshirenie"><data key="e_type">verifies</data><data key="e_why">опыт демонстрирует расширение газа при нагревании</data></edge>
    <edge id="e14931" source="C.physics.obnaruzhenie-deystviya-sil-molekulyarnogo-prityazheniya" target="C.physics.prityazhenie-chastits-veschestva"><data key="e_type">verifies</data><data key="e_why">опыт обнаруживает притяжение молекул</data></edge>
    <edge id="e14932" source="C.physics.otsenka-diametra-atoma-metodom-ryadov" target="C.physics.razmery-atomov-i-molekul"><data key="e_type">verifies</data><data key="e_why">в работе оценивается размер атома</data></edge>
    <edge id="e14933" source="C.physics.opredelenie-razmerov-malyh-tel" target="C.physics.otsenka-diametra-atoma-metodom-ryadov"><data key="e_type">prerequisites_for</data><data key="e_why">используется метод рядов, освоенный при измерении малых тел</data></edge>
    <edge id="e14934" source="C.physics.mehanicheskoe-dvizhenie" target="C.physics.mehanicheskie-yavleniya"><data key="e_type">is_a</data><data key="e_why">механическое движение — механическое явление</data></edge>
