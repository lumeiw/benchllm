    <edge id="e15862" source="C.physics.svyaz-massy-i-energii" target="C.physics.energiya-pokoya"><data key="e_type">prerequisites_for</data><data key="e_why">E₀ = mc²</data></edge>
    <edge id="e15863" source="C.physics.energiya-pokoya" target="C.physics.svyaz-energii-i-impulsa-chastitsy"><data key="e_type">prerequisites_for</data><data key="e_why">E² = E₀² + (pc)²</data></edge>
    <edge id="e15864" source="C.physics.impuls-svobodnoy-chastitsy" target="C.physics.svyaz-energii-i-impulsa-chastitsy"><data key="e_type">prerequisites_for</data><data key="e_why">в связь входит импульс частицы</data></edge>
    <edge id="e15865" source="C.physics.kvant" target="C.physics.gipoteza-planka-o-kvantah"><data key="e_type">prerequisites_for</data><data key="e_why">гипотеза: свет излучается и поглощается квантами</data></edge>
    <edge id="e15866" source="C.physics.gipoteza-planka-o-kvantah" target="C.physics.formula-planka"><data key="e_type">prerequisites_for</data><data key="e_why">энергия кванта пропорциональна частоте</data></edge>
    <edge id="e15867" source="C.physics.chastota-kolebaniy" target="C.physics.formula-planka"><data key="e_type">prerequisites_for</data><data key="e_why">E = hν</data></edge>
    <edge id="e15868" source="C.physics.foton" target="C.physics.kvant"><data key="e_type">is_a</data><data key="e_why">фотон — квант электромагнитного излучения</data></edge>
    <edge id="e15869" source="C.physics.foton" target="C.physics.energiya-fotona"><data key="e_type">prerequisites_for</data><data key="e_why">энергия фотона</data></edge>
    <edge id="e15870" source="C.physics.formula-planka" target="C.physics.energiya-fotona"><data key="e_type">prerequisites_for</data><data key="e_why">энергия фотона E = hν</data></edge>
    <edge id="e15871" source="C.physics.energiya-fotona" target="C.physics.impuls-fotona"><data key="e_type">prerequisites_for</data><data key="e_why">p = E/c</data></edge>
    <edge id="e15872" source="C.physics.svyaz-energii-i-impulsa-chastitsy" target="C.physics.impuls-fotona"><data key="e_type">prerequisites_for</data><data key="e_why">для частицы без массы покоя p = E/c</data></edge>
    <edge id="e15873" source="C.physics.svet" target="C.physics.fotoeffekt"><data key="e_type">prerequisites_for</data><data key="e_why">свет вырывает электроны из вещества</data></edge>
    <edge id="e15874" source="C.physics.fotoeffekt" target="C.physics.zakony-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">законы описывают фотоэффект</data></edge>
    <edge id="e15875" source="C.physics.opyty-stoletova" target="C.physics.zakony-fotoeffekta"><data key="e_type">verifies</data><data key="e_why">Столетов экспериментально установил законы фотоэффекта</data></edge>
    <edge id="e15876" source="C.physics.zakony-fotoeffekta" target="C.physics.uravnenie-eynshteyna-dlya-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">уравнение объясняет законы фотоэффекта</data></edge>
    <edge id="e15877" source="C.physics.energiya-fotona" target="C.physics.uravnenie-eynshteyna-dlya-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">энергия фотона идёт на работу выхода и энергию электрона</data></edge>
    <edge id="e15878" source="C.physics.rabota-vyhoda" target="C.physics.uravnenie-eynshteyna-dlya-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">в уравнение входит работа выхода</data></edge>
    <edge id="e15879" source="C.physics.kineticheskaya-energiya" target="C.physics.uravnenie-eynshteyna-dlya-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">в уравнение входит кинетическая энергия электрона</data></edge>
    <edge id="e15880" source="C.physics.fotoeffekt" target="C.physics.rabota-vyhoda"><data key="e_type">prerequisites_for</data><data key="e_why">работа выхода — энергия, нужная для вылета электрона</data></edge>
    <edge id="e15881" source="C.physics.mehanicheskaya-rabota" target="C.physics.rabota-vyhoda"><data key="e_type">prerequisites_for</data><data key="e_why">работа выхода — работа по удалению электрона из вещества</data></edge>
    <edge id="e15882" source="C.physics.uravnenie-eynshteyna-dlya-fotoeffekta" target="C.physics.krasnaya-granitsa-fotoeffekta"><data key="e_type">prerequisites_for</data><data key="e_why">красная граница — частота, при которой энергия электрона равна нулю</data></edge>
    <edge id="e15883" source="C.physics.elektricheskoe-napryazhenie" target="C.physics.zapirayuschee-napryazhenie"><data key="e_type">prerequisites_for</data><data key="e_why">напряжение, останавливающее фотоэлектроны</data></edge>
    <edge id="e15884" source="C.physics.kineticheskaya-energiya" target="C.physics.zapirayuschee-napryazhenie"><data key="e_type">prerequisites_for</data><data key="e_why">eU_зап равно наибольшей кинетической энергии электрона</data></edge>
    <edge id="e15885" source="C.physics.impuls-fotona" target="C.physics.davlenie-sveta"><data key="e_type">prerequisites_for</data><data key="e_why">фотоны передают импульс поверхности</data></edge>
    <edge id="e15886" source="C.physics.davlenie" target="C.physics.davlenie-sveta"><data key="e_type">prerequisites_for</data><data key="e_why">давление света — давление, которое свет оказывает на поверхность</data></edge>
    <edge id="e15887" source="C.physics.opyty-lebedeva" target="C.physics.davlenie-sveta"><data key="e_type">verifies</data><data key="e_why">Лебедев измерил давление света</data></edge>
    <edge id="e15888" source="C.physics.energiya-fotona" target="C.physics.himicheskoe-deystvie-sveta"><data key="e_type">prerequisites_for</data><data key="e_why">энергии фотона хватает для химических превращений</data></edge>
    <edge id="e15889" source="C.physics.fotoeffekt" target="C.physics.fotoelement"><data key="e_type">prerequisites_for</data><data key="e_why">фотоэлемент работает на фотоэффекте</data></edge>
    <edge id="e15890" source="C.physics.fotoeffekt" target="C.physics.fotodatchik"><data key="e_type">prerequisites_for</data><data key="e_why">фотодатчик реагирует на свет благодаря фотоэффекту</data></edge>
