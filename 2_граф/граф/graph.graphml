    <edge id="e15892" source="C.physics.fotoeffekt" target="C.physics.solnechnaya-batareya"><data key="e_type">prerequisites_for</data><data key="e_why">батарея преобразует свет в электрическую энергию</data></edge>
    <edge id="e15893" source="C.physics.p-n-perehod" target="C.physics.solnechnaya-batareya"><data key="e_type">prerequisites_for</data><data key="e_why">ток возникает в p-n переходе</data></edge>
